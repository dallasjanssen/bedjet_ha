# Copy this file to .env and fill it in.

# Where Home Assistant is. From inside Docker on the same machine,
# host.docker.internal points at the machine itself.
HA_URL=http://host.docker.internal:8123

# A long-lived access token: in Home Assistant open your profile, then the
# Security tab, then "Create token". Use an admin account if you want the
# "Lend to a phone" feature (it pauses and resumes the BedJet integration).
HA_TOKEN=

# Optional: only use these climate entities. Leave empty to find every BedJet
# from the BedJet integration automatically.
# BEDJET_ENTITIES=climate.dallass_bedjet

# Optional: MQTT broker, to add Start night / End night / Tonight's schedule
# entities to your BedJet in Home Assistant. Leave MQTT_HOST empty to skip.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Web UI port inside the container (change the ports: line in
# docker-compose.yml if you change this).
PORT=8099

# How many days of night history to keep.
HISTORY_DAYS=90

LOG_LEVEL=INFO
